# ─────────────────────────────────────────────────────────────
# .env.example — Blockchain & Security Module (Member 4)
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# Ganache RPC URL (default for Ganache GUI is 7545; CLI is 8545)
GANACHE_RPC_URL=http://127.0.0.1:7545

# Express server port
PORT=3001

# ── Contract addresses (filled after: truffle migrate) ───────
# Copy the output of `truffle migrate` here.
LOAN_RECORD_ADDRESS=0x0000000000000000000000000000000000000000
TX_LOG_ADDRESS=0x0000000000000000000000000000000000000000
USER_RECORD_ADDRESS=0x0000000000000000000000000000000000000000
AUDIT_TRAIL_ADDRESS=0x0000000000000000000000000000000000000000

# ── Optional: private key of the owner account ────────────────
# Usually Ganache Account[0] key — shown in Ganache UI under "Accounts"
# Only needed if you want to sign transactions from outside Ganache.
# OWNER_PRIVATE_KEY=0x...
